+    # start at 36, not 0 -- matches no row, the batch empties, and the run finishes green with an
+    # empty output. The renumbering is confined to this boundary and stated rather than hidden:
+    # the original id is kept under `bird_question_id`, and `question_id` becomes the row's
+    # position, which is what the rest of this file already assumes. The scorer maps the position
+    # back through the same input file.
+    for k, item in enumerate(batch):
