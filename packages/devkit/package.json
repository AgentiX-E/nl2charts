{
  "name": "@agentix-e/nl2charts-devkit",
  "version": "0.2.0",
  "description": "Contract tests and benchmark helpers. Never a production dependency.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@agentix-e/nl2charts-core": "workspace:*",
    "@agentix-e/nl2charts-spec": "workspace:*"
  },
  "devDependencies": {
    "@agentix-e/nl2charts-node": "workspace:*"
  }
}
