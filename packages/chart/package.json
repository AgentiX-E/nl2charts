{
  "name": "@agentix-e/nl2charts-chart",
  "version": "0.2.0",
  "description": "Deterministic chart selection, linting and ECharts option compilation. No DOM, no model.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "dependencies": {
    "@agentix-e/nl2charts-spec": "workspace:*"
  },
  "peerDependencies": {
    "echarts": ">=5.5"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  }
}
